# CitrusSplash — .gitignore
# Files listed here are NEVER uploaded to GitHub. (Lesson: S3 — secrets never leave your PC.)

# Design blueprint — the HTML prototype stays local, NEVER uploaded (Phase 1 rule)
design-reference/

# Secrets & data
.env
.env.*
*.sqlite
*.db

# Dependencies (downloaded fresh from the internet, not stored in git)
node_modules/
vendor/

# Build output (regenerated by npm run dev/build)
public/build/
public/hot

# OS / editor noise
.DS_Store
Thumbs.db
